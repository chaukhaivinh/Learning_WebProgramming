@model IEnumerable<LTW08_NhanSu.Models.Deparment>

@{
    ViewBag.Title = "SideBarDept";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row" style="margin-top:20px;">
    <div class="col-md-4">
        <div class="list-group">
            <a href="#" class="list-group-item active bg-info" style="color:white; font-weight:bold;">
                DANH SÁCH PHÒNG BAN
            </a>
            @foreach (var item in Model)
            {
                <a href="@Url.Action("ShowEmplParameter", "Employees", new { id = item.ID })" class="list-group-item">
                    @item.DisplayName
                </a>
            }
        </div>
    </div>
    <div class="col-md-8">
        <p class="text-muted">Vui lòng chọn một phòng ban ở danh mục bên trái để xem danh sách nhân viên.</p>
    </div>
</div>
