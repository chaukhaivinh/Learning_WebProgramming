
@{
    ViewBag.Title = "DangNhap";
    Layout = "~/Views/Shared/Layout_Page.cshtml";
}
<div class="card shadow-sm border-0">
    <div class="card-header bg-secondary text-white py-2">
        <h4 class="mb-0" style="font-size: 18px; font-weight: bold;">Đăng Nhập</h4>
    </div>
    <div class="card-body bg-light">
        <form action="#" method="post">
            <div class="form-group">
                <label for="email" class="font-weight-bold text-dark" style="font-size: 14px;">Email address</label>
                <input type="email" class="form-control form-control-sm" id="email" placeholder="Enter email" required>
            </div>
            <div class="form-group">
                <label for="password" class="font-weight-bold text-dark" style="font-size: 14px;">Password</label>
                <input type="password" class="form-control form-control-sm" id="password" placeholder="Password" required>
            </div>
            <div class="form-group form-check">
                <input type="checkbox" class="form-check-input" id="checkme">
                <label class="form-check-label text-secondary" for="checkme" style="font-size: 13px;">Check me out</label>
            </div>
            <button type="submit" class="btn btn-primary btn-sm px-4 font-weight-bold">Submit</button>
        </form>
    </div>
</div>

