<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Mái Hiên Sơn Phát</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/css/bootstrap.min.css">
    <style>
        .header-banner {
            background-color: #ffffff;
            border-bottom: 2px solid #ddd;
            padding: 15px 0;
            position: relative;
        }

        .brand-logo {
            max-height: 80px;
        }

        .company-name {
            color: #ff0000;
            font-weight: bold;
            font-size: 28px;
            margin-bottom: 0;
            text-transform: uppercase;
        }

        .slogan {
            color: #0275d8;
            font-style: italic;
            font-size: 16px;
        }

        .badge-red {
            background-color: red;
            color: white;
            font-weight: bold;
            padding: 8px 15px;
            border-bottom-left-radius: 20px;
            border-top-right-radius: 5px;
            position: absolute;
            top: 0;
            right: 15px;
            text-transform: uppercase;
            font-size: 12px;
        }

        .navbar-custom {
            background-color: #f8f9fa;
            border-bottom: 1px solid #ddd;
        }

        .sidebar-header {
            background-color: #00bcd4;
            color: white;
            font-weight: bold;
            padding: 8px 12px;
            margin-top: 15px;
            font-size: 16px;
        }

        .sidebar-list {
            border: 1px solid #ddd;
            border-top: none;
        }

            .sidebar-list a {
                color: #0275d8;
                text-decoration: none;
                display: block;
                padding: 8px 15px;
                border-bottom: 1px dashed #eee;
            }

                .sidebar-list a:hover {
                    background-color: #f1f1f1;
                }

        .main-content {
            margin-top: 15px;
        }

        .box-title {
            background-color: #343a40;
            color: white;
            padding: 10px 15px;
            margin-bottom: 20px;
        }
    </style>
</head>
<body>
    <div class="container position-relative bg-white mt-2">
        <div class="row align-items-center header-banner mx-0">
            <div class="col-md-3 text-center">
                <h4 class="text-danger font-weight-bold mb-0" style="font-family: Arial;">maihiensonphat<span class="text-dark">.com</span></h4>
            </div>
            <div class="col-md-6 text-center">
                <h1 class="company-name">MÁI HIÊN SƠN PHÁT</h1>
                <p class="slogan mb-1">Chuyên sản xuất & phân phối toàn quốc</p>
                <small class="text-secondary">• Bạt che, bạt xếp, linh kiện mái hiên | • Mái xếp, bạt khổ lớn, lưới xây dựng | • Tư vấn hỗ trợ thi công</small>
            </div>
            <div class="col-md-3">
                <div class="badge-red shadow-sm">Cam Kết Giá Rẻ Nhất</div>
            </div>
        </div>
    </div>
    <div class="container navbar-custom px-0">
        <nav class="navbar navbar-expand-lg navbar-light bg-light py-0">
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav mr-auto">
                    <li class="nav-item">
                        <a class="nav-link font-weight-bold text-dark px-3" href="@Url.Action("Index", "Home")">Trang chủ</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link font-weight-bold text-dark px-3" href="#">Sản phẩm</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link font-weight-bold text-dark px-3" href="@Url.Action("DangNhap", "Home")">Đăng nhập</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link font-weight-bold text-dark px-3" href="@Url.Action("DangKy", "Home")">Đăng ký</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link font-weight-bold text-dark px-3" href="@Url.Action("LienHe", "Home")">Liên hệ</a>
                    </li>
                </ul>
                <form class="form-inline my-2 my-lg-0 mr-2">
                    <input class="form-control mr-sm-2 form-control-sm" type="search" placeholder="Search">
                    <button class="btn btn-sm btn-outline-success my-2 my-sm-0" type="submit">Search</button>
                </form>
            </div>
        </nav>
    </div>
    <div class="container main-content px-0">
        <div class="row mx-0">
            <div class="col-md-3 pl-0">
                <div class="sidebar-header">Danh mục sản phẩm</div>
                <div class="sidebar-list bg-white">
                    <a href="#">Máy xếp</a>
                    <a href="#">Máy che</a>
                    <a href="#">Máy vòm</a>
                    <a href="#">Mái hiên di động</a>
                </div>
                <div class="sidebar-header">Hỗ trợ trực tuyến</div>
                <div class="sidebar-list p-3 bg-white text-secondary" style="font-size: 14px;">
                    <p class="mb-1"><strong>Hotline:</strong> 0834.658.455</p>
                    <p class="mb-0"><strong>Tư vấn:</strong> Trực tuyến 24/7</p>
                </div>
                <div class="sidebar-header">Thống kê truy cập</div>
                <div class="sidebar-list p-3 bg-white text-secondary" style="font-size: 14px;">
                    <p class="mb-1">Số người truy cập: <strong class="text-dark">87</strong></p>
                    <p class="mb-1">Số người online: <strong class="text-dark">10</strong></p>
                    <p class="mb-0">Số lượng thành viên: <strong class="text-dark">46</strong></p>
                </div>
            </div>
            <div class="col-md-9 pr-0">
                @RenderBody()
            </div>
        </div>
    </div>
    <footer class="container text-center mt-5 py-3 border-top text-secondary px-0">
        <p class="mb-0" style="font-size: 13px;">Liên hệ: Khoa Công nghệ Thông tin - Trường Đại học Công nghiệp Thực phẩm Tp.HCM</p>
        <p class="mb-0" style="font-size: 13px;">Địa chỉ: 140 Lê Trọng Tấn, Phường Tây Thạnh, Quận Tân Phú, Tp.HCM</p>
    </footer>
    <script src="https://cdn.jsdelivr.net/npm/jquery@3.5.1/dist/jquery.slim.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>