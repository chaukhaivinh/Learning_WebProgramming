<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title</title>
    <!-- Nhúng Bootstrap -->
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">

    <style>
        .green-bg {
            background-color: #8cc63f;
            color: white;
        }

        .sidebar-title {
            background-color: #8cc63f;
            color: white;
            padding: 10px;
            font-weight: bold;
            text-transform: uppercase;
            font-size: 14px;
        }

        .sidebar-list {
            border: 1px solid #ddd;
            border-top: none;
        }

            .sidebar-list a {
                color: #007bff;
                text-decoration: none;
                display: block;
                padding: 10px;
                border-bottom: 1px solid #eee;
                font-size: 13px;
                text-transform: uppercase;
            }

                .sidebar-list a:hover {
                    color: #8cc63f;
                }

        .footer-text {
            font-size: 13px;
            line-height: 1.8;
        }
    </style>
</head>
<body style="background-color: #f4f4f4;">

    <div class="container" style="background-color: #fff; box-shadow: 0 0 10px rgba(0,0,0,0.1); padding: 0;">

        <!-- TẦNG 1: HEADER (Logo & Thông tin liên hệ) -->
        <div class="row pt-3 pb-3 align-items-center m-0">
            <div class="col-md-5 text-center">
                <h2 style="color: #00a651; font-weight: bold; margin: 0; font-family: Arial, sans-serif;">Dienhoa<span style="color: #333;">24gio</span>.com</h2>
                <span style="background-color: #00a651; color: white; padding: 2px 10px; font-size: 11px;">Điện hoa toàn cầu</span>
            </div>
            <div class="col-md-7" style="font-size: 12px; line-height: 1.6;">
                <div class="row">
                    <div class="col-6">
                        <b>Hà Nội:</b><br />
                        Điện thoại: 024.73007.008 - 093.4647.172<br />
                        Địa chỉ: Số 63/445 Lạc Long Quân, Tây Hồ, Hà Nội<br />
                        Email: hn@dienhoa24gio.com
                    </div>
                    <div class="col-6">
                        <b>TP.Hồ Chí Minh:</b><br />
                        Điện thoại: 028.73007.008 - 094.7723.444<br />
                        Địa chỉ: 189 XVNT, P.17, Q. Bình Thạnh<br />
                        Email: hcm@dienhoa24gio.com
                    </div>
                </div>
            </div>
        </div>

        <!-- TẦNG 2: MENU & TÌM KIẾM -->
        <div class="green-bg d-flex justify-content-between align-items-center" style="padding: 10px 20px;">
            <div style="font-size: 13px;">
                <a href="#" class="text-white mr-3 text-decoration-none">Trang chủ</a>
                <a href="#" class="text-white mr-3 text-decoration-none">Đăng ký</a>
                <a href="#" class="text-white mr-3 text-decoration-none">Đăng Nhập</a>
                <a href="#" class="text-white text-decoration-none">Liên hệ</a>
            </div>
            <div class="d-flex">
                <input type="text" class="form-control form-control-sm" placeholder="Search" style="border-radius: 0; width: 200px;">
                <button class="btn btn-sm text-white ml-1" style="border-radius: 0; background-color: #7ab32e; border: 1px solid #6a9c27;">Search</button>
            </div>
        </div>

        <!-- TẦNG 3: PHẦN THÂN (RenderBody & Sidebar) -->
        <div class="row m-0 mt-3 pl-2 pr-2">
            <!-- Cột trái: Nội dung chính -->
            <div class="col-md-9">
                @RenderBody()
            </div>

            <!-- Cột phải: Danh mục -->
            <div class="col-md-3">
                <div class="sidebar-title">HOA THEO CHỦ ĐỀ</div>
                <div class="sidebar-list mb-4">
                    <a href="#">Hoa sinh nhật</a>
                    <a href="#">Hoa khai trương</a>
                    <a href="#">Lan hồ điệp</a>
                    <a href="#">Hoa cưới</a>
                    <a href="#">Hoa lan</a>
                    <a href="#">Hoa chia buồn</a>
                    <a href="#">Quà tặng</a>
                    <a href="#">Trái cây</a>
                </div>

                <div class="sidebar-title">CHỌN THEO GIÁ</div>
                <div class="sidebar-list">
                    <a href="#">250.000đ trở xuống</a>
                    <a href="#">250.000đ - 400.000đ</a>
                    <a href="#">400.000đ - 600.000đ</a>
                    <a href="#">600.000đ - 900.000đ</a>
                    <a href="#">Trên 1.000.000đ</a>
                </div>
            </div>
        </div>

        <!-- TẦNG 4: FOOTER -->
        <div class="green-bg text-center mt-4 footer-text" style="padding: 15px;">
            Liên hệ: Khoa Công nghệ Thông tin - Trường Đại học Công nghiệp Thực phẩm Tp.HCM<br />
            Địa chỉ: 140 Lê Trọng Tấn, Phường Tây Thạnh, Quận Tân Phú, Tp.HCM. ĐT: (028).38161673 (ext 136)
        </div>

    </div>

</body>
</html>