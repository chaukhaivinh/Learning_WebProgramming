@{
    ViewBag.Title = "Dịch vụ (Services)";
    Layout = "~/Views/Shared/Layout_Page.cshtml";
}

<!-- Services Section -->
<section class="page-section" id="services" style="padding: 100px 0;">
    <div class="container">
        <div class="text-center">
            <h2 class="section-heading text-uppercase" style="font-size: 40px; font-weight: 700; margin-top: 0; margin-bottom: 15px;">Services</h2>
            <h3 class="section-subheading text-muted" style="font-size: 16px; font-style: italic; font-weight: 400; margin-bottom: 75px;">Chúng tôi cung cấp các dịch vụ phát triển web chuyên nghiệp dưới đây.</h3>
        </div>
        <div class="row text-center">
            <!-- Dịch vụ 1: E-Commerce -->
            <div class="col-md-4">
                <span class="fa-stack fa-4x">
                    <i class="fas fa-circle fa-stack-2x text-primary"></i>
                    <i class="fas fa-shopping-cart fa-stack-1x fa-inverse"></i>
                </span>
                <h4 class="my-3" style="font-weight: 700; font-size: 24px;">E-Commerce</h4>
                <p class="text-muted">Xây dựng hệ thống cửa hàng trực tuyến hiện đại, tối ưu hóa quy trình thanh toán và nâng cao trải nghiệm mua sắm của khách hàng.</p>
            </div>
            <!-- Dịch vụ 2: Responsive Design -->
            <div class="col-md-4">
                <span class="fa-stack fa-4x">
                    <i class="fas fa-circle fa-stack-2x text-primary"></i>
                    <i class="fas fa-laptop fa-stack-1x fa-inverse"></i>
                </span>
                <h4 class="my-3" style="font-weight: 700; font-size: 24px;">Responsive Design</h4>
                <p class="text-muted">Giao diện tương thích hoàn hảo trên mọi thiết bị di động, máy tính bảng và máy tính để bàn giúp giữ chân người dùng lâu hơn.</p>
            </div>
            <!-- Dịch vụ 3: Web Security -->
            <div class="col-md-4">
                <span class="fa-stack fa-4x">
                    <i class="fas fa-circle fa-stack-2x text-primary"></i>
                    <i class="fas fa-lock fa-stack-1x fa-inverse"></i>
                </span>
                <h4 class="my-3" style="font-weight: 700; font-size: 24px;">Web Security</h4>
                <p class="text-muted">Bảo mật đa tầng chống lại các cuộc tấn công dữ liệu, đảm bảo thông tin khách hàng và hệ thống của bạn luôn được bảo vệ an toàn.</p>
            </div>
        </div>
    </div>
</section>