@model IEnumerable<LTW05_BTTL3.Models.ProductType>

@{
    ViewBag.Title = "DSLoai";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2 class="text-center" style="font-weight: bold; margin-bottom: 20px;">DANH SÁCH LOẠI SẢN PHẨM</h2>
<table class="table table-bordered table-striped">
    <thead class="thead-dark">
        <tr>
            <th>Mã loại</th>
            <th>Tên loại</th>
        </tr>

    </thead>
    <tbody>
        @foreach (var l in Model)
        {
            <tr>
                <td>@l.ID</td>
                <td>@l.DisplayName</td>
            </tr>
        }
    </tbody>
</table>

