@model IEnumerable<LTW02_Bai03.Models.Sach>
@using LTW02_Bai03.Models

@{
    ViewBag.Title = "Danh Sách Sản Phẩm";
}

<div class="row mt-4">
    <div class="col-md-3">
        <h4 style="background-color: black; color: red; padding: 10px; text-align: center; margin-bottom: 0;">LOẠI SÁCH</h4>
        <ul class="list-group" style="border-radius: 0;">
            <li class="list-group-item" style="font-weight: bold; text-align: center; color: gray;">Tên loại</li>

            @{
                var danhSachLoai = ViewBag.DS_Loai as List<LoaiSach>;
            }

            @if (danhSachLoai != null)
            {
                foreach (var loai in danhSachLoai)
                {
                    <li class="list-group-item text-center">@loai.NameType</li>
                }
            }
        </ul>
    </div>
    <div class="col-md-9">
        <h4 style="background-color: black; color: red; padding: 10px; margin-bottom: 0;">DANH SÁCH SẢN PHẨM</h4>
        <table class="table table-striped table-bordered text-center" style="margin-top: 0;">
            <thead>
                <tr>
                    <th>Mã sách</th>
                    <th>Tên sách</th>
                    <th>Giá</th>
                    <th>Hình ảnh</th>
                    <th>Mã loại</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var sach in Model)
                {
                    <tr>
                        <td>S0@(sach.ID)</td>
                        <td>@sach.Name</td>
                        <td>@sach.Price</td>
                        <td>@sach.Image</td>
                        <td>@sach.IDType</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>