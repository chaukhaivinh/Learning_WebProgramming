
@{
    ViewBag.Title = "ChiTietSach";
}
<div class="row mt-5" style="border: 1px solid #ddd; padding: 20px; border-radius: 8px;">
    <div class="col-md-4 text-center">
        <img src="~/Content/Images/@Model.CoverPhoto" alt="@Model.Name" style="max-width: 100%; height: auto; box-shadow: 0 4px 8px rgba(0,0,0,0.1);" />
    </div>
    <div class="col-md-8">
        <p style="font-size: 16px;">Tác giả: <span style="color: #007bff; font-weight: bold;">@Model.Author</span></p>
        <h3 style="color: #333;">@Model.Name</h3>
        <h2 class="mt-3 mb-4" style="color: #d9534f;"><b>@Model.Price VNĐ</b></h2>
        <button class="btn btn-primary mb-4" style="padding: 10px 20px; font-weight: bold;">🛒 Thêm Vào Giỏ Hàng</button>
        <hr />
        <h5 style="color: gray; text-transform: uppercase; font-size: 16px;">Mô tả sản phẩm</h5>
        <p style="font-size: 15px; text-align: justify; line-height: 1.6; color: #555;">
            @Model.Description
        </p>
    </div>
</div>

