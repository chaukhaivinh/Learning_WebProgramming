<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@ViewBag.Title</title>
    <!-- Link Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
    <!-- Header xanh dương -->
    <header style="background-color: #007bff; color: white;">
        <div class="container d-flex justify-content-between align-items-center py-3">
            <h4 class="mb-0">🏆 Quán Ăn Vặt Vui Vẻ</h4>
            <div>
                <a href="/Store/Menu" class="text-white text-decoration-none ms-4">Chọn món</a>
                <a href="#" class="text-white text-decoration-none ms-4">Đăng nhập</a>
                <a href="#" class="text-white text-decoration-none ms-4">Đăng ký</a>
            </div>
        </div>
    </header>

    <!-- Header xanh lá (Gọi từ Controller bằng Action) -->
    @Html.Action("_CategoryMenu", "Cart")

    <!-- Nội dung thay đổi từng trang -->
    <main class="container mt-3 p-5 bg-white shadow-sm" style="min-height: 400px;">
        @RenderBody()
    </main>
</body>
</html>