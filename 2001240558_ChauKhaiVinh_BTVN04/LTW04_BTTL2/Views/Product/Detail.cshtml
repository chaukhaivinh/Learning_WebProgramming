@model LTW04_BTTL2.Models.ProductDetailViewModel

@{
    ViewBag.Title = "Chi tiết sản phẩm";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="row">
        <!-- Cột trái: Chi tiết sản phẩm + Partial View Thống kê -->
        <div class="col-md-6 mb-4">
            <div class="d-flex">
                <img src="@Model.ProductInfo._Image" alt="@Model.ProductInfo._Name" class="img-fluid rounded me-4" style="max-width: 200px; object-fit: cover;" />
                <div>
                    <h4>@Model.ProductInfo._Name</h4>
                    <p class="text-muted" style="font-size: 14px;">Mô tả: @Model.ProductInfo._Decription</p>
                    <p><strong>Giá: </strong><span class="text-danger fw-bold">@Model.ProductInfo._Price.ToString("N0") ₫</span></p>
                </div>
            </div>

            <!-- Gọi Partial View Tổng quan đánh giá (ReviewSummary.cshtml) -->
            @Html.Partial("ReviewSummary", Model.FeedBackInfo)
        </div>

        <!-- Cột phải: Partial View Danh sách bình luận (CommentList.cshtml) -->
        <div class="col-md-6 mb-4">
            @Html.Partial("CommentList", Model.FeedBackInfo._Comments)
        </div>
    </div>
</div>