@model List<LTW04_BTTL3.Models.Category>

<div style="background-color: #0d9488; padding: 10px 20px;">
    <ul style="list-style: none; margin: 0; padding: 0; display: flex; gap: 20px;">
        @foreach (var cat in Model)
        {
            <li>
                <a href="@Url.Action("MonAn", "Home", new { maLoai = cat.MaLoai })"
                   style="color: white; text-decoration: none; font-weight: 500;">
                    @cat.TenLoai
                </a>
            </li>
        }
    </ul>
</div>