<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Quán Ăn Vặt Vui Vẻ</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
</head>
<body style="background-color: #f3f4f6;">

    <!-- Header Navbar chính -->
    <header style="background-color: #0284c7; color: white; padding: 12px 20px;">
        <div class="d-flex justify-content-between align-items-center">
            <h4 style="margin: 0; font-weight: bold;">🍿 Quán Ăn Vặt Vui Vẻ</h4>
            <div>
                <a href="@Url.Action("MonAn", "Home")" style="color: white; text-decoration: none; margin-right: 15px;">Chọn món</a>
                <a href="#" style="color: white; text-decoration: none; margin-right: 10px;">Đăng nhập</a>
                <a href="#" style="color: white; text-decoration: none;">Đăng ký</a>
            </div>
        </div>
    </header>

    <!-- Nhúng Menu Danh mục (Partial View) -->
    @Html.Action("_CategoryMenu", "Home")

    <!-- Nội dung thay đổi của từng View -->
    <main class="container my-5">
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer style="text-align: center; padding: 15px; background-color: #e5e7eb; color: #6b7280; margin-top: 50px;">
        <p style="margin: 0;">&copy; 2026 Quán Ăn Vặt Vui Vẻ - HUIT</p>
    </footer>

</body>
</html>