
@{
    ViewBag.Title = "DangNhap";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow">
            <div class="card-header bg-danger text-white font-weight-bold text-center">
                ĐĂNG NHẬP KHÁCH HÀNG
            </div>
            <div class="card-body">
                @if (ViewBag.ThongBao != null)
                {
                    <div class="alert alert-danger">@ViewBag.ThongBao</div>
                }

                @using (Html.BeginForm("DangNhap", "BookStore", FormMethod.Post))
                {
                    <div class="form-group">
                        <label>Số điện thoại:</label>
                        <input type="text" name="sdt" class="form-control" required placeholder="Nhập số điện thoại..." />
                    </div>
                    <div class="form-group">
                        <label>Mật khẩu:</label>
                        <input type="password" name="matKhau" class="form-control" required placeholder="Nhập mật khẩu..." />
                    </div>
                    <button type="submit" class="btn btn-danger btn-block font-weight-bold">ĐĂNG NHẬP</button>
                }
            </div>
        </div>
    </div>
</div>


