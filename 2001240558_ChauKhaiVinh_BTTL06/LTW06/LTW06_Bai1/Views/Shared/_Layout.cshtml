<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - Nhà Sách Trực Tuyến</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        a{
            color:#163300;
        }
    </style>
</head>

<body>
    <!-- Header / Thanh Menu Điều Hướng -->
    <nav class="navbar navbar-expand-lg navbar-light font-weight-bold" style="background-color: #9FE870;">
        <!-- Đổi Url.Action từ Index -> DSSP -->
        <a class="navbar-brand" style="color: #163300;" href="@Url.Action("DSSP", "BookStore")">NHÀ SÁCH ONLINE</a>
        <div class="collapse navbar-collapse">
            <ul class="navbar-nav mr-auto">
                <li class="nav-item">
                    <a class="nav-link" href="@Url.Action("DSSP", "BookStore")">Trang chủ</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="@Url.Action("TimKiem", "BookStore")">Tìm kiếm nâng cao</a>
                </li>
            </ul>
            <div class="text-dark">
                @if (Session["User"] != null)
                {
                    var kh = (LTW06_Bai1.Models.Customer)Session["User"];
                    <span>Chào bạn, <strong>@kh.DisplayName</strong>! | </span>
                    <a href="@Url.Action("DangXuat", "BookStore")" class="btn btn-sm btn-outline-light">Đăng xuất</a>
                }
                else
                {
                    <a href="@Url.Action("DangNhap", "BookStore")" class="btn btn-sm font-weight-bold" style="background-color: #163300; color: #9FE870 ">LOGIN</a>
                }
            </div>
        </div>
    </nav>

    <!-- Thân trang: Menu loại bên trái (3 cột) + Nội dung chính bên phải (9 cột) -->
    <div class="container-fluid mt-4">
        <div class="row">
            <!-- Cột Menu Trái (3 cột) gọi ChildAction DSLoai -->
            <div class="col-md-3">
                @Html.Action("DSLoai", "BookStore")
            </div>

            <!-- Cột Nội dung hiển thị (9 cột) nhận dữ liệu từ RenderBody() -->
            <div class="col-md-9">
                @RenderBody()
            </div>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.5.1.slim.min.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>