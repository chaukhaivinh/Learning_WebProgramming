@model List<LTW09_BT1.Models.Sach>

@{
    ViewBag.Title = "Trang Chủ";
    Layout = "~/Views/Shared/UserLayout.cshtml";
}

<h4 class="text-primary font-weight-bold border-bottom pb-2 mb-3">DANH SÁCH SÁCH MỚI CẬP NHẬT</h4>

<div class="row">
    @foreach (var item in Model)
    {
        <div class="col-md-4 mb-4">
            <div class="card h-100 text-center shadow-sm">
                <img src="@Url.Content("~/Images/" + item.AnhBia)" class="card-img-top mx-auto mt-3" style="height:200px; width:auto; object-fit:contain;" alt="@item.TenSach" />
                <div class="card-body d-flex flex-column">
                    <h6 class="card-title font-weight-bold text-truncate">@item.TenSach</h6>
                    <p class="card-text text-danger font-weight-bold">Giá: @String.Format("{0:0,0}", item.GiaBan) VNĐ</p>
                    <div class="mt-auto">
                        @Html.ActionLink("Xem chi tiết", "XemChiTiet", "Books", new { id = item.MaSach }, new { @class = "btn btn-info btn-sm" })
                    </div>
                </div>
            </div>
        </div>
    }
</div>