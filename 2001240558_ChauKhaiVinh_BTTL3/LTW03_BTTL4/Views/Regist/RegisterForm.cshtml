
@{
    ViewBag.Title = "RegisterForm";
}

<div class="container" style="max-width: 600px; margin-top: 30px;">
    <h2 style="font-weight: bold; text-align: center;">ENTER INFORMATION TO REGIST AN COURSE</h2>

    <form action="/Regist/RegisterForm" method="post" enctype="multipart/form-data" style="border: 1px solid #ccc; padding: 20px;">

        <fieldset>
            <legend>Identificate Information</legend>

            <div class="form-group">
                <label>Full Name</label>
                <!-- Thuộc tính name="FullName" giúp MVC tự gán dữ liệu vào thuộc tính FullName của Model -->
                <input type="text" name="FullName" class="form-control" placeholder="Nhập họ tên đầy đủ" required />
            </div>

            <div class="form-group">
                <label>ID Student</label>
                <input type="text" name="IdStudent" class="form-control" placeholder="Nhập mã sinh viên" required />
            </div>

            <div class="form-group">
                <label>Email</label>
                <input type="email" name="Email" class="form-control" placeholder="yennnh@cntp.edu.vn" required />
            </div>

            <div class="form-group">
                <label>File Image input</label>
                <input type="file" name="fileUpload" class="form-control-file" />
            </div>

            <div class="form-group">
                <label>Note</label>
                <textarea name="Note" class="form-control" rows="3" placeholder="Nhập ghi chú"></textarea>
            </div>
        </fieldset>

        <fieldset style="margin-top: 15px;">
            <legend>We are Known by</legend>
            <!-- Checkbox có value="true". Khi tích chọn, MVC hiểu là true, ngược lại là false -->
            <label><input type="checkbox" name="Check1" value="true" /> Television</label><br />
            <label><input type="checkbox" name="Check2" value="true" /> Website</label><br />
            <label><input type="checkbox" name="Check3" value="true" /> Newspaper</label>
        </fieldset>

        <fieldset style="margin-top: 15px;">
            <legend>Choose Work Time</legend>
            <!-- Radio button: các mục có cùng name="ChooseWorkTime" để chỉ được chọn một -->
            <label><input type="radio" name="ChooseWorkTime" value="Morning (2 - 4 - 6)" checked /> Morning (2 - 4 - 6)</label><br />
            <label><input type="radio" name="ChooseWorkTime" value="Afternoon (2 - 4 - 6)" /> Afternoon (2 - 4 - 6)</label><br />
            <label><input type="radio" name="ChooseWorkTime" value="Morning (3 - 5 - 7)" /> Morning (3 - 5 - 7)</label><br />
            <label><input type="radio" name="ChooseWorkTime" value="Afternoon (3 - 5 - 7)" /> Afternoon (3 - 5 - 7)</label>
        </fieldset>

        <fieldset style="margin-top: 15px; margin-bottom: 20px;">
            <legend>Selects an Course</legend>
            <div class="form-group">
                <select name="SelectCourse" class="form-control">
                    <option value="1">1. Html CSS Bootstrap</option>
                    <option value="2">2. ASP.Net MVC</option>
                    <option value="3">3. Javascript nâng cao</option>
                    <option value="4">4. Lập trình Web API</option>
                </select>
            </div>
        </fieldset>

        <div class="row">
            <div class="col-xs-6">
                <button type="submit" class="btn btn-primary btn-block">Submit Button</button>
            </div>
            <div class="col-xs-6">
                <button type="reset" class="btn btn-default btn-block">Reset Button</button>
            </div>
        </div>
    </form>
</div>

